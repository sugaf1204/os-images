#!/usr/bin/env bash
set -euo pipefail

image="${1:?usage: scripts/build <image>}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
src="$root/images/$image"
spec="$src/source.env"
work="$root/.build/$image"
out="$root/dist/$image"

for cmd in awk curl jq packer qemu-img sha256sum ssh-keygen stat; do
  command -v "$cmd" >/dev/null || { echo "missing command: $cmd" >&2; exit 1; }
done

test -d "$src" || { echo "unknown image: $image" >&2; exit 2; }
test -f "$spec" || { echo "missing source spec: $spec" >&2; exit 2; }

# shellcheck disable=SC1090
. "$spec"

: "${SOURCE_URL:?SOURCE_URL is required}"
: "${OS_FAMILY:?OS_FAMILY is required}"
: "${OS_VERSION:?OS_VERSION is required}"
: "${DEFAULT_USER:?DEFAULT_USER is required}"
: "${ROOT_PARTITION_NUMBER:?ROOT_PARTITION_NUMBER is required}"

arch="${ARCH:-amd64}"
root_filesystem="${ROOT_FILESYSTEM:-}"
efi_partition_number="${EFI_PARTITION_NUMBER:-}"
efi_filesystem="${EFI_FILESYSTEM:-vfat}"
image_variant="${IMAGE_VARIANT:-}"
apt_packages="${APT_PACKAGES:-}"
apt_install_recommends="${APT_INSTALL_RECOMMENDS:-true}"
deploy_targets="${DEPLOY_TARGETS:-baremetal}"
baremetal_driver_packages="${BAREMETAL_DRIVER_PACKAGES:-}"
disk_size="${DISK_SIZE:-0}"
vm_memory="${PACKER_MEMORY:-2048}"
vm_cpus="${PACKER_CPUS:-2}"
qemu_accelerator="${PACKER_QEMU_ACCELERATOR:-}"
source_checksum="${SOURCE_CHECKSUM:-}"
source_checksum_url="${SOURCE_CHECKSUM_URL:-}"
source_checksum_file="${SOURCE_CHECKSUM_FILE:-$(basename "$SOURCE_URL")}"
source_checksum_type="${SOURCE_CHECKSUM_TYPE:-}"
ssh_timeout="${PACKER_SSH_TIMEOUT:-10m}"

case "$apt_install_recommends" in
  true | false) ;;
  *)
    echo "APT_INSTALL_RECOMMENDS must be true or false" >&2
    exit 2
    ;;
esac

ubuntu_requires_baremetal_driver_packages() {
  local version="$1"
  local major="${version%%.*}"
  local rest="${version#*.}"
  local minor="${rest%%.*}"
  case "$major:$minor" in
    *[!0-9:]* | :* | *:) return 0 ;;
  esac
  if [ "$major" -lt 25 ]; then
    return 0
  fi
  if [ "$major" -eq 25 ] && [ "$minor" -lt 10 ]; then
    return 0
  fi
  return 1
}

case " $deploy_targets " in
  *" baremetal "*)
    if [ "$OS_FAMILY" = "ubuntu" ] && ubuntu_requires_baremetal_driver_packages "$OS_VERSION" && [ -z "$baremetal_driver_packages" ]; then
      echo "BAREMETAL_DRIVER_PACKAGES is required for ubuntu baremetal images before 25.10" >&2
      exit 2
    fi
    ;;
esac

resolve_source_checksum() {
  if [ -n "$source_checksum" ]; then
    printf '%s\n' "$source_checksum"
    return 0
  fi
  test -n "$source_checksum_url" || {
    echo "SOURCE_CHECKSUM or SOURCE_CHECKSUM_URL is required" >&2
    return 1
  }
  if [ -z "$source_checksum_type" ]; then
    case "$(basename "$source_checksum_url")" in
      SHA256SUMS | *SHA256*) source_checksum_type="sha256" ;;
      SHA512SUMS | *SHA512*) source_checksum_type="sha512" ;;
      *)
        echo "SOURCE_CHECKSUM_TYPE is required for $source_checksum_url" >&2
        return 1
        ;;
    esac
  fi
  local digest
  digest="$(curl -fsSL "$source_checksum_url" | awk -v file="$source_checksum_file" '
    $0 ~ ("\\*" file "$") || $0 ~ ("[[:space:]]" file "$") {
      print $1
      found=1
      exit
    }
    $0 ~ ("\\(" file "\\)[[:space:]]*=") {
      print $NF
      found=1
      exit
    }
    END { if (!found) exit 1 }
  ')" || {
    echo "checksum for $source_checksum_file not found in $source_checksum_url" >&2
    return 1
  }
  printf '%s:%s\n' "$source_checksum_type" "$digest"
}

cleanup_dir() {
  local path="$1"
  rm -rf "$path" 2>/dev/null && return 0
  command -v sudo >/dev/null || {
    echo "failed to remove $path and sudo is unavailable" >&2
    return 1
  }
  sudo rm -rf "$path"
}

source_checksum="$(resolve_source_checksum)"

cleanup_dir "$work"
cleanup_dir "$out"
mkdir -p "$work" "$out"

ssh_key="$work/packer_ed25519"
ssh-keygen -q -t ed25519 -N "" -C "gomi-os-images-packer" -f "$ssh_key"
ssh_public_key="$(cat "$ssh_key.pub")"

packer init "$root/packer"
PACKER_CACHE_DIR="${PACKER_CACHE_DIR:-$root/.packer-cache}" \
  packer build -force \
  -var "source_url=$SOURCE_URL" \
  -var "source_checksum=$source_checksum" \
  -var "output_directory=$work/packer-output" \
  -var "ssh_username=$DEFAULT_USER" \
  -var "ssh_private_key_file=$ssh_key" \
  -var "ssh_public_key=$ssh_public_key" \
  -var "ssh_timeout=$ssh_timeout" \
  -var "apt_packages=$apt_packages" \
  -var "apt_install_recommends=$apt_install_recommends" \
  -var "baremetal_driver_packages=$baremetal_driver_packages" \
  -var "disk_size=$disk_size" \
  -var "vm_memory=$vm_memory" \
  -var "vm_cpus=$vm_cpus" \
  -var "qemu_accelerator=$qemu_accelerator" \
  "$root/packer/qcow2.pkr.hcl"

test -f "$work/packer-output/root.qcow2" || {
  echo "packer did not create $work/packer-output/root.qcow2" >&2
  exit 1
}
qemu-img convert -p -O qcow2 -c "$work/packer-output/root.qcow2" "$out/root.qcow2"

(cd "$out" && sha256sum root.qcow2 > SHA256SUMS)
if ! size="$(stat -c %s "$out/root.qcow2" 2>/dev/null)"; then
  size="$(stat -f %z "$out/root.qcow2")"
fi
sha="$(cut -d' ' -f1 "$out/SHA256SUMS")"

root_partition="$(jq -n \
  --argjson number "$ROOT_PARTITION_NUMBER" \
  --arg filesystem "$root_filesystem" \
  '{number: $number} + (if $filesystem == "" then {} else {filesystem: $filesystem} end)')"

efi_partition="null"
if [ -n "$efi_partition_number" ]; then
  efi_partition="$(jq -n \
    --argjson number "$efi_partition_number" \
    --arg filesystem "$efi_filesystem" \
    '{number: $number, filesystem: $filesystem}')"
fi

package_recipe="null"
if [ -n "$apt_packages" ]; then
  package_recipe="$(jq -n \
    --arg packages "$apt_packages" \
    --argjson aptInstallRecommends "$apt_install_recommends" \
    '{
      packageManager: "apt",
      packages: ($packages | split(" ") | map(select(. != ""))),
      aptInstallRecommends: $aptInstallRecommends
    }')"
fi

deploy_targets_json="$(jq -n --arg targets "$deploy_targets" '$targets | split(" ") | map(select(. != ""))')"

module_packages_json="null"
if [ -n "$baremetal_driver_packages" ]; then
  module_packages_json="$(jq -n --arg packages "$baremetal_driver_packages" '$packages | split(" ") | map(select(. != ""))')"
fi

jq -n \
  --arg name "$image" \
  --arg osFamily "$OS_FAMILY" \
  --arg osVersion "$OS_VERSION" \
  --arg arch "$arch" \
  --arg variant "$image_variant" \
  --arg defaultUser "$DEFAULT_USER" \
  --argjson size "$size" \
  --arg sha256 "$sha" \
  --arg sourceImageURL "$SOURCE_URL" \
  --arg sourceImageChecksum "$source_checksum" \
  --argjson deployTargets "$deploy_targets_json" \
  --argjson rootPartition "$root_partition" \
  --argjson efiPartition "$efi_partition" \
  --argjson packageRecipe "$package_recipe" \
  --argjson modulePackages "$module_packages_json" \
  '{
    name: $name,
    osFamily: $osFamily,
    osVersion: $osVersion,
    arch: $arch,
    bootModes: ["uefi"],
    variant: $variant,
    capabilities: {deployTargets: $deployTargets},
    cloudInit: {
      datasource: "nocloud",
      seedTransport: "rootfs",
      defaultUser: $defaultUser
    },
    root: ({
      path: "root.qcow2",
      format: "qcow2",
      size: $size,
      sha256: $sha256,
      partitionTable: "gpt",
      rootPartition: $rootPartition
    } + (if $efiPartition == null then {} else {efiPartition: $efiPartition} end)),
    build: {
      sourceImageURL: $sourceImageURL,
      sourceImageChecksum: $sourceImageChecksum
    }
  }
  | if $packageRecipe == null then . else .build.packageRecipe = $packageRecipe end
  | if $modulePackages == null then . else .build.modulePackages = $modulePackages end
  | if .variant == "" then del(.variant) else . end' >"$out/manifest.json"
