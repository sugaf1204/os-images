#!/usr/bin/env bash
set -euo pipefail

image="${1:?usage: scripts/smoke-qcow2 <image> [qcow2-path]}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
qcow2_path="${2:-$root/dist/$image/root.qcow2}"
tmp="$(mktemp -d)"
port="$((22000 + RANDOM % 20000))"
qemu_pid=""

cleanup() {
  if [ -n "$qemu_pid" ] && kill -0 "$qemu_pid" >/dev/null 2>&1; then
    kill "$qemu_pid" >/dev/null 2>&1 || true
    wait "$qemu_pid" >/dev/null 2>&1 || true
  fi
  rm -rf "$tmp"
}
trap cleanup EXIT

case "$image" in
  debian-12) expected_id="debian"; expected_version="12" ;;
  debian-13) expected_id="debian"; expected_version="13" ;;
  ubuntu-22.04) expected_id="ubuntu"; expected_version="22.04" ;;
  ubuntu-24.04) expected_id="ubuntu"; expected_version="24.04" ;;
  ubuntu-26.04) expected_id="ubuntu"; expected_version="26.04" ;;
  fedora-44) expected_id="fedora"; expected_version="44" ;;
  *) echo "unknown image: $image" >&2; exit 2 ;;
esac

for cmd in qemu-system-x86_64 ssh ssh-keygen xorriso; do
  command -v "$cmd" >/dev/null || { echo "missing command: $cmd" >&2; exit 1; }
done

test -f "$qcow2_path" || { echo "missing qcow2: $qcow2_path" >&2; exit 1; }

ssh-keygen -q -t ed25519 -N "" -C "smoke-$image" -f "$tmp/ssh_key"

cat >"$tmp/meta-data" <<EOF
instance-id: smoke-$image
local-hostname: smoke-$image
EOF

cat >"$tmp/user-data" <<EOF
#cloud-config
ssh_pwauth: false
disable_root: true
users:
  - default
  - name: validator
    gecos: Validator
    lock_passwd: true
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - $(cat "$tmp/ssh_key.pub")
EOF

xorriso -as mkisofs -output "$tmp/seed.iso" -volid cidata -joliet -rock "$tmp/meta-data" "$tmp/user-data" >/dev/null 2>&1

qemu_args=(
  -m 2048
  -machine q35
  -drive "file=$qcow2_path,if=virtio,format=qcow2,snapshot=on"
  -drive "file=$tmp/seed.iso,media=cdrom,readonly=on"
  -nic "user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$port-:22"
  -nographic
  -serial "file:$tmp/serial.log"
  -no-reboot
)

if [ "${QEMU_ACCELERATOR:-}" = "kvm" ] || { [ -z "${QEMU_ACCELERATOR:-}" ] && [ -r /dev/kvm ] && [ -w /dev/kvm ]; }; then
  qemu_args=(-enable-kvm "${qemu_args[@]}")
fi

qemu-system-x86_64 "${qemu_args[@]}" >/dev/null 2>&1 &
qemu_pid="$!"

ssh_opts=(
  -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null
  -o ConnectTimeout=5
  -o BatchMode=yes
  -i "$tmp/ssh_key"
  -p "$port"
)

deadline=$((SECONDS + 300))
while [ "$SECONDS" -lt "$deadline" ]; do
  if ssh "${ssh_opts[@]}" validator@127.0.0.1 'true' >/dev/null 2>&1; then
    break
  fi
  sleep 5
done

ssh "${ssh_opts[@]}" validator@127.0.0.1 'true' >/dev/null 2>&1 || {
  echo "SSH did not become available; serial log follows" >&2
  tail -n 200 "$tmp/serial.log" >&2 || true
  exit 1
}

remote_release="$(
  ssh "${ssh_opts[@]}" validator@127.0.0.1 'set -eu; . /etc/os-release; printf "%s %s\n" "$ID" "${VERSION_ID:-}"'
)"
remote_kernel="$(ssh "${ssh_opts[@]}" validator@127.0.0.1 'uname -r')"

read -r remote_id remote_version <<EOF
$remote_release
EOF

if [ "$remote_id" != "$expected_id" ] || [ "$remote_version" != "$expected_version" ]; then
  echo "unexpected OS release: got '$remote_release', expected '$expected_id $expected_version'" >&2
  exit 1
fi

ssh "${ssh_opts[@]}" validator@127.0.0.1 'sudo poweroff' >/dev/null 2>&1 || true

printf 'smoke boot ok: image=%s os="%s" kernel="%s"\n' "$image" "$remote_release" "$remote_kernel"
