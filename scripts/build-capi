#!/usr/bin/env bash
set -euo pipefail

image="${1:-ubuntu-22.04-capi-v1.36.4}"
image_builder="${2:?usage: scripts/build-capi IMAGE IMAGE_BUILDER_CHECKOUT}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
spec="$root/images/$image"
capi="$image_builder/images/capi"
out="$root/dist/$image"

test -d "$spec" || { echo "unknown CAPI image: $image" >&2; exit 2; }
test -f "$capi/Makefile" || { echo "invalid Image Builder checkout: $image_builder" >&2; exit 2; }

rm -rf "$capi/ansible/roles/gomi_node" "$out"
cp -R "$spec/roles/gomi_node" "$capi/ansible/roles/gomi_node"
mkdir -p "$out"

make -C "$capi" \
  PACKER_VAR_FILES="$spec/image-builder.json" \
  build-qemu-ubuntu-2204-efi

source_disk="$capi/output/ubuntu-2204-efi-kube-v1.36.4/ubuntu-2204-efi-kube-v1.36.4"
test -f "$source_disk" || { echo "Image Builder did not create $source_disk" >&2; exit 1; }
qemu-img convert -p -O qcow2 -c "$source_disk" "$out/root.qcow2"

(
  cd "$out"
  sha256sum root.qcow2 > SHA256SUMS
)
sha="$(cut -d' ' -f1 "$out/SHA256SUMS")"

jq -n \
  --arg name "$image" \
  --arg sha256 "$sha" \
  '{
    name: $name,
    osFamily: "ubuntu",
    osVersion: "22.04",
    arch: "amd64",
    bootModes: ["uefi"],
    variant: "baremetal",
    capabilities: {deployTargets: ["baremetal"]},
    cloudInit: {
      datasource: "nocloud",
      seedTransport: "rootfs",
      defaultUser: "ubuntu"
    },
    root: {
      path: "root.qcow2",
      format: "qcow2",
      sha256: $sha256,
      partitionTable: "gpt",
      rootPartition: {number: 2, filesystem: "ext4"},
      efiPartition: {number: 1, filesystem: "vfat"}
    },
    build: {
      builderVersion: "v0.1.55",
      packageManager: "apt",
      modulePackages: ["linux-modules-extra-{kernel_release}"]
    }
  }' > "$out/manifest.json"

"$root/scripts/test-capi-manifest" "$out/manifest.json"
