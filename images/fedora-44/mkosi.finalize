#!/bin/sh
set -eu

root="${BUILDROOT:?}"

truncate -s 0 "$root/etc/machine-id"
rm -f "$root/var/lib/dbus/machine-id"
rm -f "$root"/etc/ssh/ssh_host_*_key "$root"/etc/ssh/ssh_host_*_key.pub
rm -f "$root/var/log/cloud-init.log" "$root/var/log/cloud-init-output.log"
rm -rf "$root"/var/lib/cloud/* "$root"/var/cache/dnf/* "$root"/var/cache/libdnf5/*

for kernel in "$root"/usr/lib/modules/*/vmlinuz; do
  [ -e "$kernel" ] || continue
  version="$(basename "$(dirname "$kernel")")"
  ln -sf "../usr/lib/modules/$version/vmlinuz" "$root/boot/vmlinuz-$version"
done

mkdir -p "$root/sys/module/firmware_class/parameters"
: > "$root/sys/module/firmware_class/parameters/path"
chroot "$root" env TMPDIR=/tmp dracut --force --regenerate-all --no-hostonly
rm -rf "$root/sys/module"

mkdir -p "$root/etc/cloud/cloud.cfg.d"
cat >"$root/etc/cloud/cloud.cfg.d/99_gomi_nocloud.cfg" <<'EOF'
datasource_list: [ NoCloud, None ]
datasource:
  NoCloud:
    seedfrom: /var/lib/cloud/seed/nocloud/
ssh_deletekeys: false
EOF
